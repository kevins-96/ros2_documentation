<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>design_lab</name>
  <version>0.1.0</version>
  <description>Study lab: checking ROS 2 design documents against Rolling (name mapping, participants, QoS semantics, actions, generated messages).</description>
  <maintainer email="study@example.com">study</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>action_msgs</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>std_msgs</depend>
  <depend>study_interfaces</depend>
  <exec_depend>tcpdump</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
